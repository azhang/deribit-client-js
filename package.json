{
  "name": "deribit-client-js",
  "version": "0.1.0",
  "private": false,
  "description": "Deribit JSON-RPC client for JavaScript/TypeScript, generated from Deribit's published OpenAPI and AsyncAPI specs",
  "keywords": [
    "deribit",
    "crypto",
    "options",
    "json-rpc",
    "websocket",
    "openapi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azhang/deribit-client-js.git"
  },
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check-spec": "node scripts/check-spec.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.mjs\"",
    "test:live": "DERIBIT_LIVE=1 node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
